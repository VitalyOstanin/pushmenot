ARG SDK_IMAGE
FROM ${SDK_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libx11-6 libxcb1 libxdamage1 libxext6 libxfixes3 libxrender1 \
        libnss3 libpulse0 libgl1 libglu1-mesa libdrm2 libgbm1 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/android-sdk/emulator:${PATH}"
ENV ANDROID_AVD_HOME=/avd
RUN sdkmanager --install "emulator"

ARG ANDROID_API=34
ARG ANDROID_IMAGE_TAG=google_apis
RUN system_image="system-images;android-${ANDROID_API};${ANDROID_IMAGE_TAG};x86_64" \
    && sdkmanager --install "$system_image" \
    && echo no | avdmanager create avd -n pushmenot -k "$system_image" -d pixel_6
